{
  "name": "cops-and-robbers",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Cops&Robbers: prototipo 3D voxel con crediti virtuali, Vite e Three.js.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:standalone": "node scripts/buildStandalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/three": "0.180.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "7.1.5"
  }
}
